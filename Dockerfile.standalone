FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp/antigravity-home

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /tmp/antigravity-home /workspace /data \
    && chmod 1777 /tmp/antigravity-home

COPY pyproject.toml setup.py ./
COPY bridge ./bridge

RUN python -m pip install --upgrade pip \
    && python -m pip install .

COPY scripts ./scripts
COPY README.md ./

EXPOSE 8090

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8090/health >/dev/null || exit 1

CMD ["python", "-m", "uvicorn", "bridge.main:app", "--host", "0.0.0.0", "--port", "8090"]
