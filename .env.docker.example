# Google authentication
GEMINI_API_KEY=

# Bridge
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8090
BRIDGE_MAX_CONCURRENT_JOBS=2
BRIDGE_JOB_TIMEOUT_SECONDS=900

# Optional proxy
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,host.docker.internal

# CPU compatibility
# Set this only when you have a compatible custom localharness binary.
# ANTIGRAVITY_HARNESS_PATH=/opt/antigravity/localharness
#
# On old x86-64 CPUs without AVX the bridge automatically checks this path.
# Put the legacy binary at ./legacy-bin/localharness-legacy or change:
ANTIGRAVITY_LEGACY_HARNESS_PATH=/opt/antigravity/localharness-legacy
